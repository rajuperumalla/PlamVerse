# ─────────────────────────────────────────────────────────────────────────────
# PalmVerse — environment variables
#
# Local dev:  copy this file to `.env` and fill in the values.
# Vercel:     add these in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Google AI (Gemini) API key used by all Genkit server flows:
#   - generate-palm-reading
#   - validate-palm-images
#   - generate-*-numerology-report
#   - suggest-report-improvements
# Without this, every AI report/validation call will fail in production.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
