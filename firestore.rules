/**
 * @fileoverview Firestore Security Rules for the PalmVerse application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user can only access their own profile data and their associated palm reading reports.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, with the userId matching the Firebase Authentication UID.
 * - /users/{userId}/palmReadings/{palmReadingId}: Stores palm reading reports for a specific user.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own user documents.
 * - Users can only create, read, update, and delete palm reading reports associated with their user ID.
 * - Listing of user documents is forbidden to protect user privacy.
 *
 * Denormalization for Authorization:
 * The `userId` field in `PalmReading` documents is used to enforce ownership. This avoids the need for complex queries or `get()` calls to determine ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with UID 'user_abc' can create their own user document.
     * @allow (get, update, delete) User with UID 'user_abc' can read, update, and delete their own user document.
     * @deny (create) User with UID 'user_xyz' cannot create a user document with ID 'user_abc'.
     * @deny (get, update, delete) User with UID 'user_xyz' cannot read, update or delete the document of user 'user_abc'.
     * @principle Enforces document ownership for all operations on user documents.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Prevent listing of all user documents.

      // Self-creation: Allow a user to create their own document.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;

      // Enforce ownership and document existence for updates and deletes.
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id; //Prevents modification of user id
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to palm reading reports for a specific user.
     * @path /users/{userId}/palmReadings/{palmReadingId}
     * @allow (create) User with UID 'user_abc' can create a palm reading report under their user document.
     * @allow (get, list, update, delete) User with UID 'user_abc' can read, list, update, and delete their own palm reading reports.
     * @deny (create) User with UID 'user_xyz' cannot create a palm reading report under user 'user_abc'.
     * @deny (get, list, update, delete) User with UID 'user_xyz' cannot read, list, update, or delete palm reading reports belonging to user 'user_abc'.
     * @principle Enforces ownership for all operations on palm reading reports.
     */
    match /users/{userId}/palmReadings/{palmReadingId} {

      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}